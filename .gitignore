# Ignore generated data
src/csv/*
src/logs/*
src/ModelSave/*
src/para/*
src/figures/*

# But keep the folder structure
!src/csv/.gitkeep
!src/logs/.gitkeep
!src/ModelSave/.gitkeep
!src/para/.gitkeep
!src/figures/.gitkeep

# Other common patterns
__pycache__/
*.pyc
*.pt
*.pth
*.log
*.npy
*.npz
*.csv
*.txt
*.pdf
*.png
